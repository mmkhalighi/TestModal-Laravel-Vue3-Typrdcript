{
    "compilerOptions": {
        "target": "ES2022",
        "useDefineForClassFields": true,
        "module": "ESNext",
        "moduleResolution": "Bundler",

        "strict": true,
        "jsx": "preserve",

        "resolveJsonModule": true,
        "isolatedModules": true,
        "esModuleInterop": true,

        "allowImportingTsExtensions": true,
        "noEmit": true,

        "skipLibCheck": true,

        "types": [
            "vite/client"
        ],

        "baseUrl": ".",

        "paths": {
            "@/*": [
                "./resources/js/*"
            ]
        }
    },

    "include": [
        "resources/**/*.ts",
        "resources/**/*.d.ts",
        "resources/**/*.vue"
    ]
}
